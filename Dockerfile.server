FROM node:18-alpine

WORKDIR /app

# Copy package files
COPY server/package*.json ./

# Install dependencies
RUN npm ci

# Copy source
COPY server/src ./src
COPY server/tsconfig.json ./

# Build
RUN npm run build

# Remove dev dependencies
RUN npm prune --omit=dev

# Expose port
EXPOSE 5000

# Start server
CMD ["npm", "start"]
